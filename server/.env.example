# node Safety Dashboard — Server Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

DB_HOST=your-rds-host.rds.amazonaws.com
DB_USER=admin
DB_PASSWORD=your-db-password
DB_PORT=3306
DB_NAME=cam_sur

# Allowed CORS origin (e.g. https://yourdomain.com or http://localhost:3000 for dev)
CORS_ORIGIN=http://localhost:3000

# ─── Supabase – Incident metadata storage ────────────────────────────────────────────
# Supabase stores incident metadata and S3 URLs (NOT the actual video clips)
# Video clips remain in S3, only their URLs are stored in Supabase
# SECURITY: Use SERVICE ROLE key for backend (NOT anon/publishable key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── AWS S3 – Video clip storage ────────────────────────────────────────────────────
# S3 stores actual video clip files (.mp4)
# Clip key pattern: s3://<S3_BUCKET_NAME>/clips/<YYYY-MM-DD>/<camera-id>-<time>.mp4
#
# Backend generates presigned URLs for clips and stores them in Supabase
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_CLIPS_PREFIX=clips/
S3_CLIPS_PRESIGN_EXPIRES=3600

# Legacy: CSV-based incident data (deprecated - now using Supabase)
# Leave S3_INCIDENTS_PREFIX for backward compatibility with migration script
S3_INCIDENTS_PREFIX=incidents/
