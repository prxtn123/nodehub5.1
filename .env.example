# Node Safety Dashboard - Environment Variables

# ============================================================================
# FRONTEND CONFIGURATION (.env in root directory)
# ============================================================================

# Backend API URL
# Point to your backend server (local development or production)
REACT_APP_API_URL=http://localhost:3002

# AWS Cognito Configuration
# SECURITY: Only Cognito User Pool ID and Client ID should be in frontend
# NEVER put AWS access keys in frontend environment variables
REACT_APP_AWS_REGION=us-east-1
REACT_APP_USER_POOL_ID=your-cognito-user-pool-id
REACT_APP_USER_POOL_WEB_CLIENT_ID=your-cognito-web-client-id

# Feature Flags
REACT_APP_ENABLE_AUTH=true
REACT_APP_AUTO_REFRESH_INTERVAL=10000
REACT_APP_DEBUG_MODE=false

# Deployment
REACT_APP_VERSION=0.1.0
REACT_APP_ENVIRONMENT=development

# ============================================================================
# BACKEND CONFIGURATION (server/.env)
# ============================================================================

# Server Configuration
PORT=3002
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database Configuration (MySQL/RDS)
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_USER=admin
DB_PASSWORD=your-secure-password
DB_NAME=cam_sur
DB_PORT=3306

# AWS Credentials (Backend Only - IAM User with minimal permissions)
# SECURITY: These should ONLY be in backend .env, NEVER in frontend
# Recommended: Use IAM roles instead when running on EC2/ECS/Lambda
AWS_ACCESS_KEY_ID=your-backend-aws-access-key
AWS_SECRET_ACCESS_KEY=your-backend-aws-secret-key
AWS_REGION=us-east-1

# AWS Cognito Configuration (Backend)
# User Pool ID for JWT validation and admin operations
AWS_USER_POOL_ID=your-cognito-user-pool-id

# S3 Configuration
S3_BUCKET_NAME=your-incident-data-bucket
S3_INCIDENTS_PREFIX=incidents/
S3_CLIPS_PREFIX=clips/
S3_CLIPS_PRESIGN_EXPIRES=3600

# ============================================================================
# SECURITY NOTES
# ============================================================================

# 1. NEVER commit .env files to version control
# 2. Frontend (.env) should ONLY contain:
#    - API URLs
#    - Cognito User Pool ID and Web Client ID (public info)
#    - Feature flags
# 3. Backend (server/.env) should contain:
#    - AWS credentials (or use IAM roles)
#    - Database credentials
#    - Cognito User Pool ID for JWT validation
# 4. Use different credentials for development and production
# 5. Rotate credentials regularly
# 6. Use AWS Secrets Manager or Parameter Store for production

# ============================================================================
# IAM POLICY RECOMMENDATIONS
# ============================================================================

# Backend AWS credentials should have minimal permissions:
# {
#   "Version": "2012-10-17",
#   "Statement": [
#     {
#       "Effect": "Allow",
#       "Action": [
#         "s3:GetObject",
#         "s3:ListBucket"
#       ],
#       "Resource": [
#         "arn:aws:s3:::your-bucket-name",
#         "arn:aws:s3:::your-bucket-name/*"
#       ]
#     },
#     {
#       "Effect": "Allow",
#       "Action": [
#         "cognito-idp:ListUsers",
#         "cognito-idp:AdminDeleteUser"
#       ],
#       "Resource": "arn:aws:cognito-idp:region:account-id:userpool/pool-id"
#     }
#   ]
# }
